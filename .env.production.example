# =============================================================================
# VideoToText AI — Production Environment Variables Configuration Template
# =============================================================================
# Copy this file to .env.production and provide strong random credentials.
# NEVER commit the filled .env.production file to version control.
# =============================================================================

# Domain & Reverse Proxy Settings
DOMAIN_NAME=videototext.ai
HTTP_PORT=80
HTTPS_PORT=443
ALLOWED_ORIGINS=https://videototext.ai,https://app.videototext.ai

# Database (PostgreSQL 16)
POSTGRES_DB=videototext_prod
POSTGRES_USER=videototext_user
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_POSTGRES_SECRET_PASSWORD

# Message Broker (RabbitMQ 3.13)
RABBITMQ_USER=videototext_admin
# Generate: openssl rand -base64 32
RABBITMQ_PASSWORD=CHANGE_ME_IN_PRODUCTION_RABBITMQ_SECRET_PASSWORD
RABBITMQ_VHOST=videototext
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Cache & State Guard (Redis 7)
# Generate: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION_REDIS_SECRET_PASSWORD
REDIS_PORT=6379

# Object Storage (MinIO / AWS S3)
MINIO_BUCKET=videototext
# For MinIO Self-Hosted or AWS S3 credentials
MINIO_ROOT_USER=videototext_s3_admin
# Generate: openssl rand -base64 32
MINIO_ROOT_PASSWORD=CHANGE_ME_IN_PRODUCTION_S3_SECRET_KEY
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1

# Application Security (JWT HMAC-SHA512)
# Generate: openssl rand -base64 64 (Minimum 512 bits)
JWT_SECRET=CHANGE_ME_MUST_BE_AT_LEAST_64_CHARACTERS_LONG_HEX_OR_BASE64_KEY_VALUE_FOR_SHA512

# AI Worker Configurations
WORKER_CONCURRENCY=2
DEFAULT_ASR_MODEL=large-v3
DEFAULT_COMPUTE_TYPE=float16
MODEL_CACHE_DIR=/app/models
LOG_LEVEL=INFO

# Resource Quotas
MAX_STORAGE_PER_USER_BYTES=21474836480
MAX_CONCURRENT_JOBS_PER_USER=3
